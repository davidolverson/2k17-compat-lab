{
  "name": "2k17-compat-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Clean-room interoperability lab. Protocol code is evidence-classified and not a claim about NBA 2K17 unless explicitly documented.",
  "scripts": {
    "test": "node tests/run.js",
    "start:capture": "node server/src/index.js server/config.local.json",
    "import:evidence": "node scripts/import-sanitized-capture.js",
    "hash:artifact": "node scripts/hash-cache-artifact.js",
    "analyze:artifact": "node scripts/analyze-cache-artifact.js",
    "capture:ws": "node scripts/start-websocket-capture.js server/realtime.websocket.local.json",
    "capture:udp": "node scripts/start-udp-capture.js server/realtime.udp.local.json",
    "compare:artifact": "node scripts/compare-cache-analysis.js",
    "analyze:request": "node scripts/analyze-request-capture.js"
  },
  "engines": {
    "node": ">=16"
  }
}
